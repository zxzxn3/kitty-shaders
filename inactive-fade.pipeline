# inactive-fade —— 不活跃的部分颜色变淡，就这么多。
#
# 没有渐变、没有计时、没有跨帧状态，所以也没有「时间参数必须和动画窗口配套」
# 这类耦合。两个组互斥，各自只在对应的状态下活跃，所以永远只上色一次：
#   失焦期间   → 整个窗口去饱和
#   有焦点期间 → 没聚焦的分屏去饱和（活动分屏照常）
#
# 两者都只用事件、不写时长。animation_step 0 = 不申请周期性帧
# （kitty 内部把它转成 MONOTONIC_T_MAX），只在别的原因触发重绘时跟着走；
# 焦点变化本身就会触发重绘，所以效果立刻出现，空闲时零开销。

# ── 可调参数（这个效果的所有旋钮都在这里）──
# 去多少饱和。0.0 = 不动，1.0 = 彻底黑白；含义是保留 (1 - FADE_DESAT) 的色度。
var float FADE_DESAT 0.20
# 亮度系数。1.0 = 完全不动亮度（当前）；想额外压暗再往下调，0.92 很轻、0.8 明显。
var float FADE_DIM 1.0
# 分屏边界羽化多少像素（只对下面第二组有意义）。
var float FADE_EDGE_PX 1.5

# 失焦：整个窗口去饱和
startgroup
    animation_start os-window-focus-out
    animation_stop os-window-focus-in
    animation_step 0
    var bool WHOLE_WINDOW true
    shaders inactive-fade
endgroup

# 有焦点：只有没聚焦的分屏去饱和
startgroup
    animation_start os-window-focus-in
    animation_stop os-window-focus-out
    animation_step 0
    shaders inactive-fade
endgroup
