# Cursor ink trail; subscribing to trail events replaces Kitty's built-in trail.
# Set cursor_trail_start_threshold to 1 to include single-cell movements.

# Ink blending strength.
var float INK_STRENGTH 0.12
# Ink color in linear RGB, range 0..1.
var float3 INK_COLOR float3(1.0, 1.0, 1.0)

startgroup
    var float TRAIL_LENGTH 72.0
    var float RIM_STRENGTH 0.065
    var float HALO_STRENGTH 0.025
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    animation_step 16
    shaders ink-stroke
endgroup
