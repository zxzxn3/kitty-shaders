# Volumetric clouds adapted from nimitz's Protean Clouds (CC BY-NC-SA 3.0).
# Sample rows into texture a, then interpolate and blend; use only one animated background.

# Marching steps: higher values add detail and cost; values below 32 can expose gaps.
var int CLOUD_STEPS 48
# Compute one row per stride and interpolate the rest; 1 computes every row, larger values soften clouds and reduce cost.
var int CLOUD_ROW_STRIDE 4
# Lighting samples per marching step.
var int CLOUD_LIGHT_TAPS 1
# Deformation iterations per step; affect cost and cloud shape.
var int CLOUD_MAP_ITER 4
# Time scale: higher values increase drift speed.
var float CLOUD_TIME_SCALE 0.2
# Use the mouse to control the view.
var bool CLOUD_MOUSE false
# Linear brightness multiplier.
var float CLOUD_STRENGTH 0.12
# Background replacement strength; 0 leaves the background unchanged.
var float CLOUD_MIX 1.0

textures a

# Pass 1: compute clouds into temporary texture a.
startgroup
    animation_step 200
    shaders cloud-bg
    output_texture a
endgroup

# Interpolate and blend; attach and matching intervals synchronize both passes.
startgroup
    attach
    animation_step 200
    shaders cloud-bg-apply
endgroup
