# 体积云，源自 nimitz 的 Protean clouds（CC BY-NC-SA 3.0）。
# 第一趟按行抽样写纹理 a，第二趟垂直插值并混合背景；背景四选一。

# 步进数；越大越饱满、越慢，低于 32 容易看穿。
var int CLOUD_STEPS 48
# 每几行算一次云（其余行插值）。1 = 原版那样逐行算；越大越省，云越"软"。
var int CLOUD_ROW_STRIDE 4
# 每步光照采样次数。
var int CLOUD_LIGHT_TAPS 1
# 每步形变迭代数；影响成本和云形态。
var int CLOUD_MAP_ITER 4
# 时间缩放；越大漂移越快。
var float CLOUD_TIME_SCALE 0.2
# 鼠标控制视角。
var bool CLOUD_MOUSE false
# 线性亮度乘数。
var float CLOUD_STRENGTH 0.12
# 背景像素被云替换的程度。0 = 完全不动背景。
var float CLOUD_MIX 1.0

textures a

# 1) 算云 → 临时纹理 a
startgroup
    animation_step 200
    shaders cloud-bg
    output_texture a
endgroup

# 插值并上色；attach 和相同步长使两趟同步，避免额外申请帧。
startgroup
    attach
    animation_step 200
    shaders cloud-bg-apply
endgroup
