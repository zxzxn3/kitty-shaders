# Fade inactive splits while focused; window-fade handles unfocused windows to avoid double fading.
# Group variables isolate the two fade configurations.

startgroup
    animation_start os-window-focus-in
    animation_stop os-window-focus-out
    animation_step 0
    var float FADE_DESAT 0.45
    var float FADE_DIM 1.0
    shaders fade
endgroup
