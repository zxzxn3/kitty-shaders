# Desaturate unfocused windows; focus events request redraws, with no periodic timer.
# Group variables isolate the two fade configurations.

startgroup
    animation_start os-window-focus-out
    animation_stop os-window-focus-in
    animation_step 0
    var bool WHOLE_WINDOW true
    var float FADE_DESAT 0.45
    var float FADE_DIM 1.0
    shaders fade
endgroup
