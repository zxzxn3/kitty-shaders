# 窗口聚焦时脉动，周期帧只在动画期间申请。

# 峰值线性亮度。
var float PULSE_PEAK 0.05
# 从边缘向内的衰减距离（像素）。
var float PULSE_BAND_PX 48.0
# 渐入占整段动画的比例。
var float PULSE_ATTACK 0.12

startgroup
    animation_start os-window-focus-in
    animation_stop 600
    animation_curve linear
    animation_step 16
    shaders focus-pulse
endgroup
