# Pulse on window focus; request periodic redraws only during the animation.

# Peak linear brightness.
var float PULSE_PEAK 0.05
# Inward falloff distance from the edge, in pixels.
var float PULSE_BAND_PX 48.0
# Attack duration as a fraction of the complete animation.
var float PULSE_ATTACK 0.12

startgroup
    animation_start os-window-focus-in
    animation_stop 600
    animation_curve linear
    animation_step 16
    shaders focus-pulse
endgroup
