# 双层视差星场；背景四选一。

# STAR_CELL：格子边长（像素）；越小越密。
# STAR_DENSITY：有星格子的比例。STAR_BRIGHT：线性亮度。
# STAR_SPEED：像素/秒；为 0 时可关闭周期帧。
# STAR_FAR_SCALE：远景尺寸和亮度比例。STAR_FAR_SPEED：远景速度比例。

# 保留纹理声明，避免切换背景时改变纹理集合。
textures a

startgroup
    # 60fps；速度超过约 2px/帧会出现跳动。
    animation_step 16
    var float STAR_CELL 26.0
    var float STAR_DENSITY 0.35
    var float STAR_BRIGHT 0.55
    var float STAR_SPEED 30.0
    var float STAR_FAR_SCALE 0.55
    var float STAR_FAR_SPEED 0.35
    shaders star-hash
endgroup
