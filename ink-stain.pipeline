# ink-stain —— 墨痕：光标走过的地方留下白色水痕，慢慢干掉。
# 背景保持原样，墨只洇在背景上，不压字。

textures a persist

# ── 可调参数（这个效果的所有日常旋钮都在这里，shader 里是默认值和实现细节）──
# 墨干得快慢，秒。和下面第一组的 animation_stop 是一对：窗口要留够时间让墨干完，
# 经验值是 4 倍左右，窗口短了最后一帧的墨会被冻在屏幕上不再变化。
var float INK_DRY_TIME 0.85
# 墨最浓时往墨色混多少：0.20 是一层薄雾，0.35 明显。
var float INK_STRENGTH 0.20
# 墨色。想要彩色墨就改这里，写法是 float3(r, g, b)，范围 0..1。
var float3 INK_COLOR float3(1.0, 1.0, 1.0)

# 1) 旧墨按真实时间变干，顺手落下这一笔 → 临时纹理 a
startgroup
    animation_start cursor-trail-move | user-activity
    # 要和上面的 INK_DRY_TIME 配套：约等于 4 倍才够墨干透
    animation_stop 3200
    animation_step 16
    shaders ink-stain-accumulate
    output_texture a
endgroup

# 2) 把 a 搬回 persist。同一趟不能又读又写 persist，所以必须分两趟。
startgroup
    attach
    animation_step 16
    shaders ink-stain-commit
    output_texture persist
endgroup

# 3) 把墨洇进背景。attach 让这一组跟着上面两组一起启停，空闲时不占 GPU。
startgroup
    attach
    animation_step 16
    shaders ink-stain-composite
endgroup
